# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/leadgen

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Admin Credentials ───────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ─── SMTP / Outreach (JSON array of account objects) ─────────────────────────
SMTP_SENDERS=[{"email":"info@yourdomain.com","smtp_host":"smtp.hostinger.com","smtp_port":465,"password":"app_password","daily_limit":80}]

# ─── App Settings ────────────────────────────────────────────────────────────
APP_NAME=TEB Solutions LeadGen
FRONTEND_URL=http://localhost:5174
REPORTS_DIR=reports

# ─── AI Search Providers (Free-tier eligible & Multi-Engine) ─────────────────
AI_SEARCH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLE_SEARCH_GROUNDING=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_ENABLE_WEB_SEARCH=false
PERPLEXITY_API_KEY=

# ─── Groq API (Two-Key Rotation, Independent Accounts & Quota Scopes) ────────
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY=
# Optional quota scopes (defaults to groq_account_1 and groq_account_2 for independent quotas):
GROQ_QUOTA_SCOPE_1=
GROQ_QUOTA_SCOPE_2=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Lead Discovery Providers (Two-Key Rotation, Independent Accounts & Adapters)
SERPER_API_KEY_1=
SERPER_API_KEY_2=
SERPER_API_KEY=
# Optional quota scopes (defaults to serper_account_1 and serper_account_2):
SERPER_QUOTA_SCOPE_1=
SERPER_QUOTA_SCOPE_2=
TREG_API_KEY_1=
TREG_API_KEY_2=
TREG_API_KEY=
TREG_API_TOKEN=
# Optional quota scopes (defaults to treg_account_1 and treg_account_2):
TREG_QUOTA_SCOPE_1=
TREG_QUOTA_SCOPE_2=
TREG_ENABLE_PAID_ENDPOINTS=false
SERPAPI_API_KEY=
HASDATA_API_KEY=
OUTSCRAPER_API_KEY=
HUNTER_API_KEY=
